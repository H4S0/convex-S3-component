{
  "name": "@hasoo/convex-s3",
  "version": "0.2.0",
  "description": "Convex component for S3-compatible object storage: presigned upload/download URLs and file metadata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H4S0/convex-S3-component.git"
  },
  "homepage": "https://github.com/H4S0/convex-S3-component#readme",
  "bugs": {
    "url": "https://github.com/H4S0/convex-S3-component/issues"
  },
  "keywords": [
    "convex",
    "convex-component",
    "s3",
    "aws-s3",
    "r2",
    "minio",
    "storage",
    "file-upload"
  ],
  "type": "module",
  "private": false,
  "packageManager": "pnpm@10.28.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./convex.config": {
      "types": "./dist/convex/convex.config.d.ts",
      "default": "./dist/convex/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/convex/convex.config.d.ts",
      "default": "./dist/convex/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/convex/_generated/component.d.ts",
      "default": "./dist/convex/_generated/component.js"
    },
    "./_generated/component.js": {
      "types": "./dist/convex/_generated/component.d.ts",
      "default": "./dist/convex/_generated/component.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "codegen": "convex codegen --component-dir ./convex",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:local": "pnpm run build && pnpm pack",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "convex": "^1.32.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "convex": "^1.32.0"
  }
}
